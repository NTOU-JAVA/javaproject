  -TronclassSessionStore sessionStore
  +getState() State
  +getUserName() String
  +getCookie() String
  +isLoggedIn() boolean
  +onLoginSuccess(String, String) void
  +restoreSavedSession() boolean
  +logout() void
  +notifySessionExpired() void
  +addListener(SessionListener) void
}

class State {
  <<enumeration>>
  LOGGED_OUT
  LOGGED_IN
  EXPIRED
}

class SessionListener {
  <<interface>>
  +onStateChanged(State, String) void
}

class TronclassService {
  -String BASE_URL
