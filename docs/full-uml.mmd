CalendarPanel --> ReminderEditorPanel
CalendarPanel --> ReminderChips

TodoPanel --> TodoItem
TodoPanel --> CategoryManager
TodoPanel --> ReminderEditorPanel
TodoPanel --> ReminderChips

SchedulePanel --> Schedule
SchedulePanel --> Course
SchedulePanel --> PdfScheduleImporter
SchedulePanel *-- StyledComboBoxUI
SchedulePanel *-- SlotRow

SchoolNewsPanel --> SchoolNewsCrawler
SchoolNewsPanel --> NewsItem

CategoryTagBar --> CategoryManager
TronclassLoginDialog --> TronclassService
