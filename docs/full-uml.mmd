classDiagram
direction LR

%% =========================
%% App Entry
%% =========================

class Main {
  -List~Task~ tasks
  -List~TodoItem~ todos
  -List~Schedule~ schedules
  -CategoryManager categoryManager
  -XmlDataStore dataStore
  -MainFrame mainFrame
  -ReminderService reminderService
  -TrayManager trayManager
  +main(String[] args) void
  -saveTasksToXML() void
  -saveTodosToXML() void
  -saveSchedulesToXML() void
  -hideToTray() void
  -toggleReminderPause() void
  -showReminderNotification(ReminderNotification) void
  -exitApplication() void
}

%% =========================
%% Model Layer
%% =========================

class Task {
  -int id
  -String title
  -String description
  -String date
  -String time
  -boolean hasDeadline
  -boolean important
  -boolean completed
  -String category
  -List~Reminder~ reminders
  +getTitle() String
  +getContent() String
  +hasDeadline() boolean
  +isImportant() boolean
  +isCompleted() boolean
  +setReminders(List~Reminder~) void
}

class TodoItem {
  -int id
  -String title
  -String description
  -String reminderTime
  -String deadlineTime
  -boolean completed
  -String category
  -String sourceUrl
  -List~Reminder~ reminders
  +getTitle() String
  +getDeadlineTime() String
  +isCompleted() boolean
  +setDeadlineTime(String) void
  +setReminders(List~Reminder~) void
}

class Reminder {
  -Type type
  -String dateTime
  -int minutesBefore
  +absolute(String) Reminder
  +beforeDeadline(int) Reminder
  +resolve(LocalDateTime) LocalDateTime
  +toDisplayText() String
}

class ReminderType {
  <<enumeration>>
  ABSOLUTE
  BEFORE_DEADLINE
}

class Schedule {
  -int id
  -String name
  -boolean active
  -List~Course~ courses
  +getCourses() List~Course~
  +isActive() boolean
}

class Course {
  -int id
  -String name
  -String code
  -String location
  -String professor
  -String department
  -String classYear
  -int dayOfWeek
  -int startPeriod
  -int endPeriod
  -String note
  -int colorIndex
  -String scheduleString
}

class NewsItem {
  -int id
  -String title
  -String url
  -String fetchedTime
}

%% =========================
%% Persistence Layer
%% =========================

class XmlDataStore {
  -String TASKS_XML
  -String TODOS_XML
  -String SCHEDULES_XML
  +loadTasks(List~Task~) void
  +loadTodos(List~TodoItem~) void
  +loadSchedules(List~Schedule~) void
  +saveTasks(List~Task~) void
  +saveTodos(List~TodoItem~) void
  +saveSchedules(List~Schedule~) void
  -parse(File) Document
  -newDocument() Document
  -loadReminderList(Element) ArrayList~Reminder~
  -appendReminders(Document, Element, List~Reminder~) void
  -writeXML(Document, String) void
}

class TronclassSessionStore {
  -String SESSION_FILE
  +load() SavedSession
  +save(String, String) void
  +clear() void
}

class SavedSession {
  -String userName
  -String cookie
  +getUserName() String
  +getCookie() String
}

%% =========================
%% Service Layer
%% =========================

class CategoryManager {
  +String ALL
  +String NONE
  -String XML_PATH
  -List~String~ categories
  -List~Runnable~ listeners
  -List~Consumer~ removeListeners
  -List~BiConsumer~ renameListeners
  +getCategories() List~String~
  +getAllOptions() List~String~
  +isProtected(String) boolean
  +addCategory(String) boolean
  +removeCategory(String) boolean
  +renameCategory(String, String) boolean
  +addListener(Runnable) void
}

class ReminderService {
  -List~Task~ tasks
  -List~TodoItem~ todos
  -Notifier notifier
  -Runnable onChanged
  -Set~String~ shownReminderKeys
  -Timer scanTimer
  -boolean paused
  +start() void
  +stop() void
  +isPaused() boolean
  +togglePaused() boolean
